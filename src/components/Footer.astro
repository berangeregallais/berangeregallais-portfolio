---
export interface Props {
  lang: "en" | "fr";
}

const { lang } = Astro.props;

const content = {
  en: {
    copyright: "© 2026 Bérangère Gallais. All rights reserved.",
    skills: "Skills",
    portfolio: "Portfolio",
    contact: "Contact",
    legal: "Legal Notice",
    privacy: "Privacy Policy",
    cookies: "Manage cookies",
  },
  fr: {
    copyright: "© 2026 Bérangère Gallais. Tous droits réservés.",
    skills: "Compétences",
    portfolio: "Portfolio",
    contact: "Contact",
    legal: "Mentions légales",
    privacy: "Politique de confidentialité",
    cookies: "Gérer les cookies",
  },
};

const text = content[lang];
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-links">
        <a href={lang === "fr" ? `/${lang}/competences` : `/${lang}/skills`}>{text.skills}</a>
        <a href={`/${lang}/portfolio`}>{text.portfolio}</a>
        <a href={`/${lang}/contact`}>{text.contact}</a>
        <a href={`/${lang}/legal-notice`}>{text.legal}</a>
        <a href={`/${lang}/privacy-policy`}>{text.privacy}</a>
        <button type="button" class="footer-cookie-btn" data-cookie-settings>
          {text.cookies}
        </button>
      </div>
      <p class="copyright">{text.copyright}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 3rem 0 2rem;
    background: rgb(var(--color-surface) / 0.3);
    border-top: 1px solid rgb(var(--color-border) / 0.2);
  }

  .footer-content {
    text-align: center;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .footer-links a {
    color: rgb(var(--color-text-muted));
    text-decoration: none;
    font-size: 0.9rem;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: rgb(var(--color-primary));
  }

  .footer-cookie-btn {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    color: rgb(var(--color-text-muted));
    font-size: 0.9rem;
    font-family: inherit;
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .footer-cookie-btn:hover {
    color: rgb(var(--color-primary));
  }

  .copyright {
    color: rgb(var(--color-text-muted));
    margin: 0;
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    .footer-links {
      flex-direction: column;
      gap: 0.8rem;
    }
  }
</style>
