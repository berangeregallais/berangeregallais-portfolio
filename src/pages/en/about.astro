---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About | QA Automation Engineer / SDET | Bérangère Gallais"
  description="QA Automation Engineer / SDET & Technical Writer. Test automation, web development, AI agents (LangGraph, Claude API). Available for a permanent position."
>
  <section class="about-hero">
    <div class="container">
      <div class="about-hero__grid">
        <div class="about-hero__text">
          <h1 class="title">Hello, I'm Bérangère 👋</h1>
          <p class="lead">
            Specialized engineer with <strong>6 years of experience</strong> in
            software engineering, over <strong
              >4 of which dedicated exclusively to test automation and
              technical documentation</strong
            >. My work is built on precision, analysis and reliability:
            designing test suites, hardening CI/CD pipelines and ensuring
            deliverables are compliant. Based in Le Mans, France, I'm looking
            for a <strong>QA Automation Engineer, permanent</strong
            > position.
          </p>
          <ul class="bullets">
            <li>
              <strong>Automation:</strong> Playwright, Cypress, Selenium, Appium,
              Postman (API), k6 (performance), security testing
            </li>
            <li>
              <strong>Languages:</strong> Python, JavaScript/TypeScript, Java
            </li>
            <li>
              <strong>Documentation & methods:</strong> Docs-as-Code, OpenAPI, XRay,
              Git, CI/CD
            </li>
            <li>
              <strong>AI agents:</strong> trained in LangGraph (Introduction to LangGraph,
              Agent Observability & Evaluations, Ambient Agents), RAG and multi-agent
              architectures
            </li>
          </ul>
          <div class="cta-row">
            <a href="/en/contact" class="btn btn-primary">Get in touch</a>
            <a href="/about/cv-bgallais-en.pdf" download class="btn">Download my CV</a>
          </div>
        </div>
        <div class="about-hero__media">
          <img
            src="/about/portrait.jpg"
            alt="Portrait of Bérangère Gallais"
            class="about-portrait"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="about-background">
    <div class="container">
      <h2>My background</h2>
      <div class="background-grid">
        <div class="bg-item">
          <div class="bg-icon">🤖</div>
          <div class="bg-role">Agent Engineer</div>
          <div class="bg-meta">Independent · 10/2025 – 06/2026 · Fully remote</div>
          <p>
            Designing and deploying custom conversational agents: RAG
            architectures connected to internal knowledge bases, multilingual
            platforms and multi-agent systems. Response quality validation
            and non-regression testing.
          </p>
        </div>
        <div class="bg-item">
          <div class="bg-icon">📚</div>
          <div class="bg-role">Technical Writer</div>
          <div class="bg-meta">Independent · 08/2025 – 10/2025 · Fully remote</div>
          <p>
            API and product documentation for tech and AI companies: developer
            guides, OpenAPI specifications, a Docs-as-Code approach integrated
            into CI/CD. Endpoint verification (Postman) to ensure
            documentation accuracy.
          </p>
        </div>
        <div class="bg-item">
          <div class="bg-icon">✅</div>
          <div class="bg-role">QA Automation Engineer · AssessFirst</div>
          <div class="bg-meta">04/2022 – 07/2025 · Fully remote</div>
          <p>
            E2E test automation (Cypress-Cucumber-Gherkin then Reflect.run) and
            API testing (Postman). Built the XRay-Cypress pipeline, performance
            testing (k6) and technical API documentation.
          </p>
        </div>
        <div class="bg-item">
          <div class="bg-icon">👩‍💻</div>
          <div class="bg-role">Full-stack developer → QA automation tester · ApsideTOP</div>
          <div class="bg-meta">10/2019 – 04/2022 · Le Mans, then fully remote</div>
          <p>
            Design and development of web applications (Java, Angular), then
            transition into test automation: writing and maintaining test
            suites, reporting and issue tracking.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="about-cta">
    <div class="container">
      <div class="cta-box">
        <h2>Get in touch?</h2>
        <p>
          I'm available for a permanent position, in a team that
          values quality, test automation, and clear documentation.
        </p>
        <div class="cta-benefits">
          <div class="benefit">🎯 QA Automation / SDET</div>
          <div class="benefit">📋 Dev + Tests + Documentation</div>
          <div class="benefit">🤝 AI agents applied to real problems</div>
        </div>
        <div class="cta-row">
          <a href="/en/contact" class="btn btn-primary">
            <span>Get in touch</span>
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
              <path d="M5 12h14m-7-7 7 7-7 7"></path>
            </svg>
          </a>
          <a href="/about/cv-bgallais-en.pdf" download class="btn">Download my CV</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Espacement harmonisé */
  .about-hero,
  .about-background,
  .about-cta {
    padding: 4rem 0; /* Desktop */
  }

  @media (max-width: 1024px) {
    .about-hero,
    .about-background,
    .about-cta {
      padding: 3rem 0; /* Tablette */
    }
  }

  @media (max-width: 600px) {
    .about-hero,
    .about-background,
    .about-cta {
      padding: 2.5rem 0; /* Mobile */
    }
  }

  /* Section Hero */
  .about-hero__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .about-hero__grid {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }
  .about-hero__text {
    margin-bottom: 1.5rem;
  }
  .title {
    font-size: 2rem;
    line-height: 1.2;
    margin: 0 0 0.75rem;
  }
  .lead {
    font-size: 1.1rem;
    color: rgb(var(--color-text));
    margin: 0 0 1.25rem;
    line-height: 1.7;
  }
  .bullets {
    margin: 0 0 1.5rem;
    padding-left: 1.2rem;
    line-height: 1.6;
  }
  .bullets li {
    margin-bottom: 0.6rem;
  }
  .about-hero .btn {
    margin-right: 0.5rem;
  }
  .about-portrait {
    width: 100%;
    height: auto;
    border-radius: 16px;
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.06);
  }

  /* Section Parcours */
  .about-background {
    background: linear-gradient(
      135deg,
      rgb(var(--color-surface-variant) / 0.3) 0%,
      rgb(var(--color-primary) / 0.02) 100%
    );
  }
  .about-background h2 {
    text-align: center;
    margin-bottom: 1.5rem;
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: rgb(var(--color-text));
  }
  .background-grid {
    display: grid;
    gap: 2rem;
    margin-top: 1rem;
  }
  @media (min-width: 900px) {
    .background-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }
  .bg-item {
    background: rgb(var(--color-surface) / 0.8);
    border: 1px solid rgb(var(--color-border) / 0.3);
    border-radius: 16px;
    padding: 1.5rem;
    text-align: left;
    backdrop-filter: blur(10px);
    transition: all var(--transition-normal);
  }
  .bg-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgb(var(--color-shadow) / 0.1);
    border-color: rgb(var(--color-primary) / 0.3);
  }
  .bg-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    display: block;
  }
  .bg-role {
    font-size: 1.15rem;
    font-weight: 600;
    color: rgb(var(--color-text));
    margin-bottom: 0.25rem;
  }
  .bg-meta {
    font-size: 0.85rem;
    color: rgb(var(--color-primary));
    margin-bottom: 0.75rem;
  }
  .bg-item p {
    margin: 0;
    line-height: 1.6;
    color: rgb(var(--color-text-muted));
  }


  /* Section CTA */
  .about-cta {
    padding: 2rem 0 2rem;
  }
  .cta-box {
    border: 1px solid rgb(var(--color-border));
    border-radius: 16px;
    padding: 1.25rem;
    text-align: center;
    background: rgb(var(--color-background));
  }
  .cta-row {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
</style>
