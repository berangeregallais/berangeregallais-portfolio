---
// src/pages/fr/index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortfolioCard from "../../components/PortfolioCard.astro";
import BackToTop from "../../components/BackToTop.astro";
---

<BaseLayout
  title="Bérangère Gallais | QA Automation Engineer / SDET"
  description="QA Automation Engineer / SDET & Technical Writer, disponible en CDI full remote. Tests automatisés (Cypress, Playwright, Selenium, Postman, k6), développement web, agents IA (LangGraph, Claude API)."
  lang="fr"
>
  <div id="fr-index-root">
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <h1 class="hero-title">QA Automation Engineer / SDET</h1>
          <p
            class="hero-tagline"
            style="font-size: 1.5rem; font-weight: 600; margin: 1rem 0 1.5rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
          >
            À la recherche d'un poste en CDI, full remote.
          </p>
          <p class="hero-subtitle">
            6 ans d'expérience en ingénierie logicielle, dont plus de 4 ans
            dédiés exclusivement à l'automatisation de tests et à la
            documentation technique. Je conçois aussi des agents IA avec
            LangGraph et j'écris une documentation technique en Docs-as-Code,
            intégrée au workflow des équipes.
          </p>

          <div class="value-props">
            <div class="value-prop">
              ◆ <strong>QA Automation / SDET</strong> : Cypress, Playwright, Selenium,
              Postman, k6
            </div>
            <div class="value-prop">
              ◆ <strong>Développement</strong> : Java, Python, JavaScript/TypeScript
            </div>
            <div class="value-prop">
              ◆ <strong>Agents IA</strong> : LangGraph, RAG, architectures multi-agents
            </div>
            <div class="value-prop">
              ◆ <strong>Technical Writing</strong> : Docs-as-Code, OpenAPI, documentation
              API, spécifications techniques
            </div>
          </div>

          <div class="hero-cta">
            <a href="/fr/portfolio" class="btn btn-primary"
              >Voir mon portfolio</a
            >
            <a
              href="/about/cv-bgallais-fr.pdf"
              download
              class="btn btn-secondary">Télécharger mon CV</a
            >
          </div>
        </div>

        <div class="chat-preview">
          <div class="chat-header">
            <div class="agent-avatar">🤖</div>
            <div class="agent-info">
              <span class="agent-name">Assistant Documentation</span>
              <span class="agent-status">En ligne</span>
            </div>
          </div>
          <div class="chat-messages">
            <div class="message user-message">
              <div class="message-avatar">👤</div>
              <div class="message-content">
                Comment gérer les webhooks en cas d'erreur ?
              </div>
            </div>
            <div class="message agent-message">
              <div class="message-avatar">🤖</div>
              <div class="message-content">
                D'après votre documentation technique, voici la bonne pratique :<br
                /><br />

                <strong>1. Implémentez un backoff exponentiel</strong><br />
                Retry avec délais progressifs : 1s, 2s, 4s, 8s...<br /><br />

                <strong>2. Stockez les événements échoués</strong><br />
                Utilisez une queue de messages (Redis, SQS) pour rejouer les webhooks
                plus tard<br /><br />

                <strong>3. Activez les notifications d'échec</strong><br />
                Configurez des alertes dans votre dashboard pour surveiller le taux
                d'erreur<br /><br />

                📄 <em style="color: #667eea;"
                  >Source : Documentation Webhooks v2.1 (section 3.4)</em
                ><br /><br />

                Besoin d'un exemple de code ?
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Profil -->
    <section class="context-section section-spacing">
      <div class="container">
        <h2 class="section-title">Mon profil</h2>

        <div class="context-grid">
          <div class="context-card">
            <h3>Ce que je recherche</h3>
            <ul>
              <li>
                Un poste en <strong>CDI, en full remote</strong>, où la qualité est
                un travail collectif
              </li>
              <li>
                Un rôle QA Automation Engineer / SDET, ou un poste qui combine
                test, développement et documentation
              </li>
              <li>
                Une équipe où je peux appliquer si besoin mes compétences en
                agents IA à des problèmes concrets
              </li>
              <li>
                Un environnement où la documentation technique compte autant que
                le code
              </li>
            </ul>
          </div>

          <div class="context-card context-card--solution">
            <h3>Ce que j'apporte</h3>
            <ul>
              <li>
                <strong>Plus de 4 ans dédiés à l'automatisation de tests</strong
                > : Cypress, Playwright, Selenium, pipeline XRay-Cypress, Appium
              </li>
              <li>
                <strong>Double compétence dev + test</strong> : développement web
                (Java, Angular) avant de me spécialiser en QA
              </li>
              <li>
                <strong>Conception et test d'agents IA</strong> : architectures multi-agents
                LangGraph, RAG, API LLM (Claude, Gemini)
              </li>
              <li>
                <strong>Rapports à deux niveaux</strong> : rapport technique détaillé, résumé accessible pour les profils non-techniques
              </li>
            </ul>
          </div>
        </div>

        <div class="cta-services">
          <p>Le détail de ces compétences, section par section :</p>
          <div class="cta-services-buttons">
            <a href="/fr/competences" class="btn btn-secondary">
              Voir mes compétences →
            </a>
            <a href="/fr/portfolio" class="btn btn-secondary">
              Voir mon portfolio →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Portfolio -->
    <section class="proof-section section-spacing">
      <div class="container">
        <h2 class="section-title">Portfolio</h2>

        <div class="portfolio-grid-featured">
          <!-- Agent 1 : QA -->
          <div class="portfolio-featured-card">
            <div class="featured-badge featured-badge-conversational">
              Agents IA x Tests
            </div>
            <PortfolioCard
              title="QA Agent Supervisor"
              client="Orchestrateur de tests multi-agents"
              description="Système multi-agents LangGraph qui orchestre une vraie suite de tests Playwright/pytest : suggestions de couverture, triage des échecs, détection de flaky tests."
              tags={[
                "Python",
                "LangGraph",
                "Claude API",
                "Pydantic",
                "Playwright",
              ]}
              image="/portfolio/qa-agent-supervisor.png"
              link="/fr/portfolio/qa-agent-supervisor"
              category={["ai-agent", "qa"]}
              githubUrl="https://github.com/berangeregallais/qa-agent-supervisor"
              lang="fr"
            />
          </div>

          <!-- Agent 2 : RAG -->
          <div class="portfolio-featured-card">
            <div class="featured-badge featured-badge-rag">Agent RAG</div>
            <PortfolioCard
              title="Neolens Support Agent"
              client="Support technique API"
              description="Agent RAG pour support documentation API. Recherche intelligente dans plus de 200 pages, citations sources."
              tags={["Python", "FastAPI", "LangGraph", "FAISS", "Next.js 14"]}
              image="/portfolio/01-home-welcome.png"
              link="/fr/portfolio/neolens-support-agent"
              category={["ai-agent"]}
            />
          </div>
        </div>

        <div class="cta-services">
          <div class="cta-services-buttons">
            <a href="/fr/portfolio" class="btn btn-secondary">
              Voir tout le portfolio →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Disponibilité -->
    <section id="contact-cta" class="process-section section-spacing">
      <div class="container">
        <!-- CTA Section -->
        <div class="process-cta">
          <h3>Disponible pour un poste en CDI, full remote</h3>
          <p>
            QA Automation Engineer / SDET & Technical Writer, je recherche une
            équipe où mes compétences en tests, développement et agents IA
            peuvent s'appliquer à des problèmes concrets.
          </p>
          <a href="/fr/contact" class="btn btn-primary btn-large"
            >Me contacter</a
          >
          <p class="process-link">
            <a href="/about/cv-bgallais-fr.pdf" download>Télécharger mon CV →</a
            >
          </p>
        </div>
      </div>
    </section>

    <BackToTop />

    <style>
      /* ===============================
     COULEURS PERSONNALISÉES POUR CETTE PAGE
     =============================== */
      :root {
        --color-background-custom: 5, 10, 48; /* #050a30 - Bleu foncé */
        --color-primary-custom: 238, 130, 255; /* #ee82ff - Rose moins saturé */
        --color-primary-hover-custom:
          245, 150, 255; /* #f596ff - Rose clair pour hover */
        --color-accent-custom:
          240, 170, 255; /* #f0aaff - Rose doux pour accents */
      }

      /* Override des variables de couleur pour cette page */
      #fr-index-root {
        --color-background: 5, 10, 48;
        --color-primary: 238, 130, 255;
        --color-primary-hover: 245, 150, 255;
        --color-accent: 240, 170, 255;
        --color-surface: 15, 25, 65;
        --color-surface-variant: 25, 40, 90;
      }

      /* ===============================
     HERO SECTION
     =============================== */
      .hero {
        padding: 8rem 0 6rem;
        background: linear-gradient(
          135deg,
          rgb(var(--color-background)) 0%,
          rgba(var(--color-primary), 0.05) 100%
        );
        position: relative;
        overflow: hidden;
      }

      .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          radial-gradient(
            circle at 20% 80%,
            rgba(var(--color-primary), 0.08) 0%,
            transparent 50%
          ),
          radial-gradient(
            circle at 80% 20%,
            rgba(var(--color-accent), 0.05) 0%,
            transparent 50%
          );
        pointer-events: none;
      }

      .hero .container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5rem;
        align-items: center;
        position: relative;
        z-index: 1;
      }

      .hero-title {
        font-family: var(--font-hero);
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 700;
        line-height: 1.15;
        margin-bottom: 2rem;
        color: rgb(var(--color-text));
      }

      .hero-subtitle {
        font-size: 1.25rem;
        line-height: 1.7;
        color: rgb(var(--color-text-muted));
        margin-bottom: 2rem;
      }

      .hero-cta {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
      }

      /* Value Props */
      .value-props {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 2rem;
      }

      .value-prop {
        font-size: 1rem;
        color: rgb(var(--color-text));
        padding: 0.75rem 1rem;
        background: rgba(var(--color-surface-variant), 0.5);
        border-left: 3px solid rgb(var(--color-primary));
        border-radius: var(--radius-sm);
        transition: all 0.2s ease;
      }

      .value-prop:hover {
        background: rgba(var(--color-surface-variant), 0.7);
        transform: translateX(4px);
      }

      .value-prop strong {
        color: rgb(var(--color-primary));
        font-weight: 600;
      }

      /* Chat Preview */
      .chat-preview {
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-xl);
        background: rgb(var(--color-surface));
        border: 1px solid rgba(var(--color-border), 0.3);
      }

      .chat-header {
        display: flex;
        align-items: center;
        padding: 1.25rem 1.5rem;
        gap: 1rem;
        background: rgba(var(--color-surface-variant), 0.3);
        border-bottom: 1px solid rgba(var(--color-border), 0.2);
      }

      .agent-avatar {
        font-size: 2rem;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: linear-gradient(
          135deg,
          rgb(var(--color-primary)),
          rgb(var(--color-primary-hover))
        );
      }

      .agent-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .agent-name {
        font-weight: 600;
        font-size: 1rem;
        color: rgb(var(--color-text));
      }

      .agent-status {
        font-size: 0.875rem;
        color: rgb(var(--color-text-muted));
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .agent-status::before {
        content: "●";
        color: rgb(var(--color-success));
        font-size: 0.75rem;
      }

      .chat-messages {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        min-height: 320px;
        background: rgba(var(--color-surface-variant), 0.1);
      }

      .message {
        display: flex;
        gap: 0.75rem;
        max-width: 90%;
        animation: slideIn 0.3s ease;
      }

      .user-message {
        align-self: flex-end;
        flex-direction: row-reverse;
      }

      .agent-message {
        align-self: flex-start;
        animation: slideIn 0.3s ease 1s backwards;
      }

      .message-avatar {
        font-size: 1.5rem;
        flex-shrink: 0;
      }

      .message-content {
        padding: 1rem 1.25rem;
        border-radius: var(--radius-lg);
        font-size: 0.95rem;
        line-height: 1.6;
        flex: 1;
        text-align: left;
        word-wrap: break-word;
        overflow-wrap: break-word;
        hyphens: auto;
      }

      .user-message .message-content {
        background: rgb(var(--color-primary));
        color: rgb(var(--color-text-button));
        border-bottom-right-radius: 0.25rem;
      }

      .agent-message .message-content {
        background: rgba(var(--color-surface-variant), 0.8);
        color: rgb(var(--color-text));
        border-bottom-left-radius: 0.25rem;
        border: 1px solid rgba(var(--color-border), 0.7);
      }

      @keyframes slideIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* ===============================
   CONTEXT SECTION
   =============================== */
      .context-section {
        background: rgb(var(--color-surface));
      }

      .context-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin-bottom: 3rem;
      }

      .context-card {
        background: rgba(var(--color-surface-variant), 0.3);
        border: 1px solid rgba(var(--color-border), 0.3);
        border-radius: var(--radius-lg);
        padding: 2.5rem;
      }

      .context-card--solution {
        background: rgba(var(--color-primary), 0.03);
        border: 1px solid rgba(var(--color-primary), 0.2);
      }

      .context-card h3 {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        color: rgb(var(--color-text));
        margin-bottom: 1.5rem;
      }

      .context-card ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .context-card ul li {
        padding-left: 1.75rem;
        margin-bottom: 1rem;
        position: relative;
        color: rgb(var(--color-text-muted));
        line-height: 1.6;
      }

      .context-card ul li::before {
        content: "•";
        position: absolute;
        left: 0;
        color: rgb(var(--color-primary));
        font-size: 1.5rem;
        line-height: 1;
      }

      .context-card--solution ul li {
        padding-left: 2rem;
      }

      .context-card--solution ul li::before {
        content: "→";
        font-size: 1rem;
        line-height: 1.6;
      }

      .context-card strong {
        color: rgb(var(--color-text));
        font-weight: 600;
      }

      .context-result {
        text-align: center;
        padding: 2rem 2.5rem;
        background: rgba(var(--color-primary), 0.05);
        border: 2px solid rgba(var(--color-primary), 0.3);
        border-radius: var(--radius-lg);
        max-width: 900px;
        margin: 0 auto;
      }

      .context-result p {
        font-size: 1.125rem;
        color: rgb(var(--color-text));
        margin: 0;
        line-height: 1.7;
      }

      .context-result strong {
        color: rgb(var(--color-primary));
      }

      .cta-services {
        text-align: center;
        margin-top: 2.5rem;
        padding: 2rem;
        background: rgba(var(--color-accent), 0.03);
        border-radius: var(--radius-lg);
      }

      .cta-services p {
        font-size: 1.125rem;
        color: rgb(var(--color-text));
        margin-bottom: 1.5rem;
        font-weight: 500;
      }

      .cta-services-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      /* Responsive */
      @media (max-width: 1024px) {
        .context-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 768px) {
        .context-card {
          padding: 1.5rem;
        }

        .context-result {
          padding: 1.5rem;
        }
      }

      /* ===============================
   USE CASES & METRICS
   =============================== */
      .use-cases {
        margin-top: 4rem;
        padding: 2.5rem;
        background: rgba(var(--color-surface-variant), 0.3);
        border: 1px solid rgba(var(--color-border), 0.3);
        border-radius: var(--radius-lg);
      }

      .use-cases h3 {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        color: rgb(var(--color-text));
        margin-bottom: 1.5rem;
        text-align: center;
      }

      .use-cases-list {
        list-style: none;
        padding: 0;
        max-width: 700px;
        margin: 0 auto 2rem;
      }

      .use-cases-list li {
        padding-left: 1.5rem;
        margin-bottom: 0.75rem;
        position: relative;
        color: rgb(var(--color-text-muted));
        font-size: 0.95rem;
      }

      .use-cases-list li::before {
        content: "→";
        position: absolute;
        left: 0;
        color: rgb(var(--color-primary));
        font-weight: bold;
      }

      .use-cases-list li strong {
        color: rgb(var(--color-text));
        font-weight: 600;
      }

      /* ===============================
   APPROACH SECTION
   =============================== */
      .approach-section {
        background: rgb(var(--color-surface));
      }

      .approach-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
      }

      .approach-card {
        background: rgba(var(--color-surface-variant), 0.3);
        border: 1px solid rgba(var(--color-border), 0.3);
        border-radius: var(--radius-lg);
        padding: 2rem;
      }

      .approach-card h4 {
        font-family: var(--font-heading);
        font-size: 1.125rem;
        color: rgb(var(--color-text));
        margin-bottom: 0.75rem;
      }

      .approach-card p {
        color: rgb(var(--color-text-muted));
        font-size: 0.95rem;
        margin: 0;
      }

      /* ===============================
   RESPONSIVE
   =============================== */
      @media (max-width: 1024px) {
        .approach-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 768px) {
        .use-cases {
          padding: 1.5rem;
        }

        .approach-card {
          padding: 1.5rem;
        }

        .value-prop {
          font-size: 0.9rem;
        }
      }

      /* ===============================
   SECTIONS COMMUNES
   =============================== */
      .section-title {
        font-family: var(--font-heading);
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        text-align: center;
        margin-bottom: 3rem;
        color: rgb(var(--color-text));
      }

      /* ===============================
     BLOC SOLUTION
     =============================== */
      .solution-section {
        background: rgba(var(--color-surface-variant), 0.5);
      }

      .features-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        margin-bottom: 3rem;
      }

      .feature-card {
        background: rgb(var(--color-surface));
        border: 1px solid rgba(var(--color-border), 0.3);
        border-radius: var(--radius-lg);
        padding: 2rem;
        text-align: center;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }

      .feature-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-xl);
      }

      .feature-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        color: rgb(var(--color-primary));
        font-weight: 300;
        line-height: 1;
      }

      .feature-card h3 {
        font-family: var(--font-heading);
        font-size: 1.25rem;
        color: rgb(var(--color-text));
        margin-bottom: 1rem;
      }

      .feature-card p {
        color: rgb(var(--color-text-muted));
        font-size: 0.95rem;
        line-height: 1.6;
      }

      .feature-card p strong {
        color: rgb(var(--color-primary));
        font-weight: 600;
      }

      /* ===============================
     PROCESS SECTION - "Comment je travaille"
     =============================== */
      .process-section {
        background: rgba(var(--color-surface-variant), 0.5);
        padding-top: 2rem !important;
      }

      .process-cta {
        text-align: center;
        padding: 2.5rem;
        background: rgba(var(--color-primary), 0.05);
        border: 1px solid rgba(var(--color-primary), 0.2);
        border-radius: var(--radius-lg);
      }

      .process-cta h3 {
        font-size: 1.75rem;
        color: rgb(var(--color-text));
        margin-bottom: 1rem;
      }

      .process-cta > p {
        color: rgb(var(--color-text-muted));
        margin-bottom: 1.5rem;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
      }

      .process-link {
        margin-top: 1.5rem;
        font-size: 0.95rem;
        color: rgb(var(--color-text-muted));
      }

      .process-link a {
        color: rgb(var(--color-primary));
        text-decoration: none;
        font-weight: 600;
        transition: opacity 0.2s ease;
      }

      .process-link a:hover {
        opacity: 0.8;
        text-decoration: underline;
      }

      /* ===============================
     BLOC PREUVE
     =============================== */
      .proof-section {
        background: rgba(var(--color-surface-variant), 0.5);
      }

      .proof-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: center;
        margin-bottom: 4rem;
      }

      .proof-image img {
        width: 100%;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-xl);
        border: 1px solid rgba(var(--color-border), 0.3);
      }

      .proof-text p {
        color: rgb(var(--color-text-muted));
        margin-bottom: 1.5rem;
      }

      .proof-text h4 {
        color: rgb(var(--color-text));
        margin-bottom: 1rem;
        margin-top: 2rem;
        white-space: nowrap;
      }

      .tech-stack {
        list-style: none;
        padding: 0;
